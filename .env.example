# Every VITE_* value below is inlined into the public JavaScript bundle at build
# time. Treat all of them as public. Never put a password, a service_role key,
# or any other secret in this file or in .env.

# Supabase (set ENABLED=true and fill both values to use the cloud database)
VITE_SUPABASE_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Storefront settings
# WhatsApp number in international format, no + and no spaces.
VITE_WHATSAPP_NUMBER=919999999999

# Your real UPI ID, e.g. shriguruji@okhdfcbank
# Leave this blank until you have one: UPI checkout stays hidden while it is
# unset, so no customer is shown a QR code that pays nobody.
VITE_UPI_ID=

# NOTE: VITE_ADMIN_PASSWORD has been removed on purpose. Admin sign-in now uses
# Supabase Auth, because a client-side password is readable by every visitor.
